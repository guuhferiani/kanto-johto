MatchCall_Text_OakRegisterCall:
	.string "Carvalho: Olá, {PLAYER}{KUN}!\n"
	.string "Vejo que você tem um Celular!\p"
	.string "Bem, eu deveria te dar meu número.\p"
	.string "Assim poderei avaliar a sua Pokédex\n"
	.string "mesmo enquanto você estiver\l"
	.string "em campo explorando.$" 

MatchCall_Text_RegisteredOak: 
